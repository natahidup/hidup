{
  "name": "@nata/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/ui/*": "./src/components/ui/*.ts",
    "./components/ui/dialog": "./src/components/ui/dialog.ts",
    "./components/ui/menu": "./src/components/ui/menu.ts",
    "./components/ui/toast": "./src/components/ui/toast.ts",
    "./components/ui/button": "./src/components/ui/button.ts",
    "./components/ui/input": "./src/components/ui/input.ts",
    "./components/ui/label": "./src/components/ui/label.ts",
    "./components/ui/card": "./src/components/ui/card.ts",
    "./components/ui/badge": "./src/components/ui/badge.ts",
    "./components/ui/skeleton": "./src/components/ui/skeleton.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@foldkit/ui": "0.171.0",
    "@nata/tokens": "workspace:*",
    "@phosphor-icons/core": "2.1.1",
    "cn": "0.5.2",
    "effect": "4.1.4",
    "foldkit": "0.171.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "shadcn": "4.23.0"
  }
}
